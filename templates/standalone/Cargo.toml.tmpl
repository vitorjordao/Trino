# {{name}} — a standalone Trino project (generated by `cargo xtask new
# {{name}} --standalone`). `game/` is the portable game crate (PC, N64, 3DS,
# Web); `pc/`, `n64/`, `n3ds/` and `web/` are its per-platform hosts.
[workspace]
resolver = "2"
members = ["game", "pc", "n64", "n3ds", "web"]

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "MIT OR Apache-2.0"
repository = ""

[workspace.dependencies]
{{name}} = { path = "game" }
# The engine. Switch between a local checkout (path) and git here; keep them
# all on the same revision. Console builds need a local checkout (its xtask
# owns the shims and toolchains: `cargo trino build n64|3ds`).
{{trino_deps}}
# The Web host's bindings (`cargo trino build web` runs the wasm-bindgen CLI
# of the version Cargo.lock pins).
wasm-bindgen = "0.2"

[profile.dev]
opt-level = 1

[profile.release]
lto = "thin"
