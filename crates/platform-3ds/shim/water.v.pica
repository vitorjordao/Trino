; Trino 3DS water vertex program (picasso syntax), ADR 0015: the PICA200
; displaces, lights and projects a water surface (the draws
; trino_core::render3d::gpu_water accepts) instead of the CPU's water T&L.
; The same functions as trino_core::water, in floats:
;   world  = model * p
;   swell  = a0 sin(t0) + a1 sin(t1),  t = k (d . xz) - phase   (in turns)
;   ripple = s e^2 cos(2pi (d - r) / L),  e = max(0, 1 - ((d - r) / W)^2)
;   normal = normalize(-dh/dx, 1, -dh/dz)
;   color  = color / 255 * tint * (ambient + diffuse * max(0, n . l)) + emissive
;   F      = 0.85 (0.02 + 0.98 (1 - max(0, n . v))^5)
;   color  = color + (sky - color) F,  alpha + (1 - alpha) F,  + glint
;   color  = color + (fogcolor - color) clamp(fog . world, 0, 1)
; The sine is trino_core::water::sin_turns (a parabola refined by a quartic
; term after one fract), on four lanes at once: the swell's two sines and
; two cosines, then the four ripples' sines, then their cosines. Ripples
; are packed one per lane (rx, rz, rrad, rstr); a ripple of strength 0
; adds nothing.
;
; Inputs (a static vertex buffer, see trino_water_mesh):
;   v0 = (x, y, z) floats   v1 = (u, v) floats   v2 = (r, g, b, a) bytes
; PICA rule: a uniform can only be the first source of an instruction.

.fvec mvp[4]
.fvec model[3]
.fvec wdir
.fvec wk
.fvec wamp
.fvec rx
.fvec rz
.fvec rrad
.fvec rstr
.fvec lightdir
.fvec ambient
.fvec diffuse
.fvec tint
.fvec emissive
.fvec eye
.fvec sky
.fvec glint
.fvec fogrow
.fvec fogcolor
.fvec sub0
.fvec scroll
.fvec detail
.fvec detailoff

; 0, 1, 1/2, 1/4
.constf c0(0.0, 1.0, 0.5, 0.25)
; 2, -1, 4, the sine's quartic weight
.constf c1(2.0, -1.0, 4.0, 0.225)
; 1/255, 1/W (W = 0.7), 1/L (L = 0.55), F0
.constf c2(0.00392156862745098, 1.4285714, 1.8181818, 0.02)
; 1 - F0, the Fresnel mix, 2pi/L, -4/W
.constf c3(0.98, 0.85, 11.423973, -5.7142857)
; a small square distance, a small dot product
.constf c4(0.000001, 0.000001, 0.0, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.alias inpos v0
.alias inuv v1
.alias inclr v2

; sin(2pi t) of r2's four lanes, into r3 (scratch r4, r7).
.proc sin4
    add r4, c0.zzzz, r2
    flr r7, r4
    add r4, r4, -r7
    mul r4, c1.xxxx, r4
    add r4, c1.yyyy, r4
    max r7, r4, -r4
    add r7, c0.yyyy, -r7
    mul r7, r4, r7
    mul r7, c1.zzzz, r7
    max r4, r7, -r7
    mul r4, r7, r4
    add r4, r4, -r7
    mul r4, c1.wwww, r4
    add r3, r4, r7
.end

.proc main
    ; World position r1 = (x, y, z, 1).
    mov r0.xyz, inpos.xyz
    mov r0.w, c0.y
    dp4 r1.x, model[0], r0
    dp4 r1.y, model[1], r0
    dp4 r1.z, model[2], r0
    mov r1.w, c0.y

    ; The swell: lanes (t0, t1, t0 + 1/4, t1 + 1/4) -> (sin0, sin1, cos0, cos1).
    mul r5, wdir, r1.xzxz
    add r2.x, r5.x, r5.y
    add r2.y, r5.z, r5.w
    mul r2.xy, wk.xy, r2.xy
    add r2.xy, wk.zw, r2.xy
    add r2.zw, c0.wwww, r2.xyxy
    call sin4
    ; h (r6.x) = a0 sin0 + a1 sin1
    mul r5.xy, wamp.xy, r3.xy
    add r6.x, r5.x, r5.y
    ; gradient (r8.xy) = d0 a0 2pi k0 cos0 + d1 a1 2pi k1 cos1
    mul r5.xy, wamp.zw, r3.zw
    mul r5, wdir, r5.xxyy
    add r8.xy, r5.xy, r5.zw

    ; Ripples, one per lane: dx (r9), dz (r10), d (r13), 1/d (r12).
    add r9, -rx, r1.xxxx
    add r10, -rz, r1.zzzz
    mul r11, r9, r9
    mul r12, r10, r10
    add r11, r11, r12
    add r11, c4.xxxx, r11
    rsq r12.x, r11.x
    rsq r12.y, r11.y
    rsq r12.z, r11.z
    rsq r12.w, r11.w
    mul r13, r11, r12
    ; d - r (r14), q (r15), e (r5)
    add r14, -rrad, r13
    mul r15, c2.yyyy, r14
    mul r5, r15, r15
    add r5, c0.yyyy, -r5
    max r5, c0.xxxx, r5
    ; sin and cos of (d - r) / L: r11 = sin, r3 = cos
    mul r2, c2.zzzz, r14
    call sin4
    mov r11, r3
    add r2, c0.wwww, r2
    call sin4
    ; h += sum s e^2 cos
    mul r13, r5, r5
    mul r0, rstr, r13
    dp4 r0.x, r0, r3
    add r6.x, r6.x, r0.x
    ; dh/dd = s (-4 e q / W cos - e^2 2pi/L sin); gradient += dh/dd / d (dx, dz)
    mul r7, r5, r15
    mul r7, c3.wwww, r7
    mul r7, r7, r3
    mul r0, c3.zzzz, r13
    mul r0, r0, r11
    add r7, r7, -r0
    mul r7, rstr, r7
    mul r7, r7, r12
    dp4 r0.x, r7, r9
    dp4 r0.y, r7, r10
    add r8.xy, r8.xy, r0.xy

    ; Displace; the normal (r0) from the gradient.
    add r1.y, r1.y, r6.x
    mov r0.xz, -r8.xxyy
    mov r0.y, c0.y
    mov r0.w, c0.x
    dp3 r2.x, r0, r0
    rsq r2.x, r2.x
    mul r0.xyz, r0.xyz, r2.xxx

    ; Light: k = ambient + diffuse * max(0, n . l); color (r4).
    dp3 r2.x, lightdir, r0
    max r2.x, c0.x, r2.x
    mul r3.xyz, diffuse.xyz, r2.xxx
    add r3.xyz, ambient.xyz, r3.xyz
    mul r4, c2.xxxx, inclr
    mul r4, tint, r4
    mul r4.xyz, r3.xyz, r4.xyz
    add r4.xyz, emissive.xyz, r4.xyz

    ; Toward the eye (r5), Fresnel F (r2.y).
    add r5.xyz, eye.xyz, -r1.xyz
    dp3 r2.x, r5, r5
    rsq r2.x, r2.x
    mul r5.xyz, r5.xyz, r2.xxx
    dp3 r2.x, r0, r5
    max r2.x, c0.x, r2.x
    add r2.x, c0.y, -r2.x
    mul r2.y, r2.x, r2.x
    mul r2.y, r2.y, r2.y
    mul r2.y, r2.y, r2.x
    mul r2.y, c3.x, r2.y
    add r2.y, c2.w, r2.y
    mul r2.y, c3.y, r2.y
    add r6.xyz, sky.xyz, -r4.xyz
    mul r6.xyz, r6.xyz, r2.yyy
    add r4.xyz, r4.xyz, r6.xyz
    add r6.w, c0.y, -r4.w
    mul r6.w, r6.w, r2.y
    add r4.w, r4.w, r6.w

    ; The glint: (n . normalize(v + l))^exp (zero color without gloss).
    add r6.xyz, lightdir.xyz, r5.xyz
    dp3 r2.z, r6, r6
    rsq r2.z, r2.z
    mul r6.xyz, r6.xyz, r2.zzz
    dp3 r2.z, r0, r6
    max r2.z, c4.yyyy, r2.z
    lg2 r2.z, r2.z
    mul r2.z, glint.wwww, r2.z
    ex2 r2.z, r2.z
    mul r6.xyz, glint.xyz, r2.zzz
    add r4.xyz, r4.xyz, r6.xyz

    ; Fog by view depth; then clamp.
    dp4 r2.x, fogrow, r1
    max r2.x, c0.x, r2.x
    min r2.x, c0.y, r2.x
    add r6.xyz, fogcolor.xyz, -r4.xyz
    mul r6.xyz, r6.xyz, r2.xxx
    add r4.xyz, r4.xyz, r6.xyz
    min r4, c0.yyyy, r4
    max r4, c0.xxxx, r4
    mov outclr, r4

    ; Position: the world point to the screen (times the view depth).
    dp4 outpos.x, mvp[0], r1
    dp4 outpos.y, mvp[1], r1
    dp4 outpos.z, mvp[2], r1
    dp4 outpos.w, mvp[3], r1

    ; UVs: scrolled, through the image's sub-texture; the detail layer's
    ; times its scale plus its offset (tri3d.v.pica's texcoord1).
    add r7.xy, scroll.xy, inuv.xy
    mul r7.xy, sub0.zw, r7.xy
    add r7.xy, sub0.xy, r7.xy
    mov r7.zw, c0.xx
    mov outtc0, r7
    mul r8.xy, detail.xy, r7.xy
    add r8.xy, detailoff.xy, r8.xy
    mov r8.zw, c0.xx
    mov outtc1, r8
    end
.end
