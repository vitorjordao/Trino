// The pause menu, drawn over the game (Start pauses; B / Escape resumes).
(
    version: 1,
    name: "pause",
    focus: "resume",
    on_back: "resume",
    root: (
        children: [
            (kind: Rect(), anchor: Fill, bleed: true, color: Some((0, 0, 0, 160))),
            (
                kind: Rect(border: 1, border_color: Some((255, 244, 200, 255))),
                anchor: Center,
                padding: (12, 10, 12, 12),
                children: [
                    (
                        kind: Stack(gap: 6, align: Center),
                        children: [
                            (kind: Text, key: "pause.title", text: "Paused", text_scale: 2),
                            (kind: Button, id: "resume", key: "pause.resume", text: "Resume", on_click: "resume", min: (128, 18), padding: (6, 3, 6, 3)),
                            (kind: Button, id: "options", key: "pause.options", text: "Options", on_click: "options", min: (128, 18), padding: (6, 3, 6, 3)),
                            (kind: Button, id: "quit", key: "pause.quit", text: "Quit to title", on_click: "quit", min: (128, 18), padding: (6, 3, 6, 3)),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
