// Solid Eleven's season end (issue #95), over the champions' ceremony: the
// champion's crest and name, the season, and where the player's club
// finished. The game draws the crest and the banner's slanted shape.
//   cargo xtask ui export examples/solid-eleven/ui/trophy.ui.ron examples/solid-eleven/src/ui/trophy_gen.rs
(
    version: 1,
    name: "se_trophy",
    scaling: Snap,
    on_back: "continue",
    theme: (
        font: "fonts/se_ui",
        text: Some((236, 240, 255, 255)),
        dim: Some((150, 160, 196, 255)),
        panel: Some((16, 20, 46, 230)),
        button: Some((16, 20, 46, 230)),
        button_text: Some((236, 240, 255, 255)),
        focus: Some((30, 60, 130, 235)),
        focus_text: Some((236, 240, 255, 255)),
        accent: Some((40, 210, 255, 255)),
        pressed: Some((50, 110, 240, 255)),
    ),
    preview: {
    "season": Text("VIOLET WANDERERS  TEMPORADA 2027"),
    "won": Bool(true),
    "place": Text("TERMINOU EM 10/10"),
    "btn.a": Text("ENTER"),
    },
    root: (
        children: [
            (
                kind: Stack(gap: 4, align: Stretch),
                anchor: StretchCenter,
                size: (Fill, Fill),
                max: (320, 0),
                children: [
                    (kind: Overlay, min: (0, 0)),
                    (
                        kind: Overlay,
                        size: (Fill, Fit),
                        padding: (30, 6, 30, 0),
                        children: [
                            (
                                kind: Stack(dir: Horizontal, gap: 8, align: Center),
                                id: "banner",
                                size: (Fill, Fit),
                                padding: (10, 4, 10, 5),
                                children: [
                                    (kind: Overlay, id: "crest", min: (28, 32)),
                                    (
                                        kind: Stack(gap: 2, align: Center),
                                        size: (Fill, Fit),
                                        children: [
                                            (kind: Text, key: "champion", text: "CHAMPIONS", font: "fonts/se_big", color: Some((255, 214, 40, 255)), align: Center, overflow: Wrap),
                                            (kind: Text, bind: "season", text: "{}", align: Center, overflow: Wrap),
                                        ],
                                    ),
                                ],
                            ),
                        ],
                    ),
                    (kind: Overlay, size: (Fill, Fill)),
                    (
                        kind: Overlay,
                        size: (Fill, Fit),
                        children: [
                            (
                                kind: Rect(border: 1, border_color: Some((190, 255, 60, 255))),
                                id: "place",
                                anchor: Top,
                                color: Some((10, 12, 30, 235)),
                                padding: (12, 2, 12, 2),
                                visible_if: "won",
                                children: [(kind: Text, bind: "place", text: "{}", color: Some((190, 255, 60, 255)), overflow: Wrap)],
                            ),
                            (
                                kind: Rect(border: 1, border_color: Some((40, 210, 255, 255))),
                                id: "place_lost",
                                anchor: Top,
                                color: Some((10, 12, 30, 235)),
                                padding: (12, 2, 12, 2),
                                visible_if: "lost",
                                children: [(kind: Text, bind: "place", text: "{}", color: Some((40, 210, 255, 255)), overflow: Wrap)],
                            ),
                        ],
                    ),
                    (
                        kind: Stack(dir: Horizontal, gap: 3, wrap: true),
                        size: (Fill, Fit),
                        padding: (6, 0, 0, 3),
                        children: [
                            (
                                kind: Stack(dir: Horizontal, gap: 3, align: Center),
                                id: "hint_a",
                                padding: (2, 2, 5, 2),
                                children: [
                                    (kind: Rect(), color: Some((70, 210, 90, 255)), padding: (3, 0, 3, 0), min: (11, 0), children: [(kind: Text, bind: "btn.a", text: "{}", color: Some((18, 22, 52, 255)), anchor: Center)]),
                                    (kind: Text, key: "continue", text: "CONTINUE"),
                                ],
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
