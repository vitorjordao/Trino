# {{name}} — a standalone Trino project (generated by `cargo xtask new
# {{name}} --standalone`). `game/` is the portable game crate (PC, N64, 3DS);
# `pc/` is its desktop host.
[workspace]
resolver = "2"
members = ["game", "pc"]

[workspace.package]
version = "0.1.0"
edition = "2024"
license = "MIT OR Apache-2.0"
repository = ""

[workspace.dependencies]
{{name}} = { path = "game" }
# The engine. Switch between a local checkout (path) and git here; keep the
# three on the same revision.
{{trino_deps}}

[profile.dev]
opt-level = 1

[profile.release]
lto = "thin"
