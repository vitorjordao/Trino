// Solid Eleven's career start (issue #95): the ten clubs to manage and the
// pick's identity (formation, strength, balance, style). The game keeps the
// cursor (`cur.pick`: up/down one club, left/right five) and draws each
// crest, the pick's colored rim and the style bars into their boxes. At
// 150 % text and up the identity stays above the grid (`_big` ids).
//   cargo xtask ui export examples/solid-eleven/ui/pick.ui.ron examples/solid-eleven/src/ui/pick_gen.rs
(
    version: 1,
    name: "se_pick",
    scaling: Snap,
    on_back: "back",
    theme: (
        font: "fonts/se_ui",
        text: Some((236, 240, 255, 255)),
        dim: Some((150, 160, 196, 255)),
        panel: Some((16, 20, 46, 230)),
        button: Some((16, 20, 46, 230)),
        button_text: Some((236, 240, 255, 255)),
        focus: Some((30, 60, 130, 235)),
        focus_text: Some((236, 240, 255, 255)),
        accent: Some((40, 210, 255, 255)),
        pressed: Some((50, 110, 240, 255)),
    ),
    preview: {
    "short0": Text("ROU"),
    "name": Text("VIOLET WANDERERS"),
    "facts": Text("4-3-3  GER 78  SALDO 15.200"),
    "btn.a": Text("ENTER"),
    "btn.b": Text("ESC"),
    },
    root: (
        children: [
            (kind: Rect(), anchor: Fill, bleed: true, color: Some((6, 8, 20, 150))),
            (
                kind: Stack(gap: 4, align: Stretch),
                anchor: StretchCenter,
                size: (Fill, Fill),
                max: (320, 0),
                children: [
                    (
                        kind: Stack(dir: Horizontal, gap: 4, align: Center, justify: SpaceBetween, wrap: true),
                        id: "header_row",
                        size: (Fill, Fit),
                        min: (200, 22),
                        padding: (0, 3, 8, 3),
                        children: [
                            (
                                kind: Stack(dir: Horizontal, gap: 4, align: Center),
                                id: "header",
                                children: [
                                    (kind: Button, id: "back", text: "<", on_click: "back", min: (20, 16), color: Some((40, 210, 255, 0)), padding: (4, 1, 4, 1)),
                                    (kind: Text, key: "career", text: "CAREER"),
                                ],
                            ),
                        ],
                    ),
                    (
                        kind: Rect(border: 1, border_color: Some((0, 0, 0, 0))),
                        id: "ident_big",
                        visible_if: "big",
                        color: Some((0, 0, 0, 0)),
                        size: (Fill, Fit),
                        padding: (6, 3, 6, 4),
                        children: [
                            (
                                kind: Stack(gap: 2, align: Stretch),
                                size: (Fill, Fit),
                                children: [
                                    (kind: Text, bind: "name", text: "{}", overflow: Wrap),
                                    (kind: Text, bind: "facts", text: "{}", color: Some((255, 214, 40, 255)), overflow: Wrap),
                                    (
                                        kind: Grid(cols: 4, gap: (8, 2)),
                                        size: (Fill, Fit),
                                        children: [
                                            (
                                                kind: Stack(gap: 1, align: Stretch),
                                                size: (Fill, Fit),
                                                children: [
                                                    (kind: Text, text: "PRESS", color: Some((150, 160, 196, 255))),
                                                    (kind: Overlay, id: "style0_big", size: (Fill, Px(3))),
                                                ],
                                            ),
                                            (
                                                kind: Stack(gap: 1, align: Stretch),
                                                size: (Fill, Fit),
                                                children: [
                                                    (kind: Text, text: "LINE", color: Some((150, 160, 196, 255))),
                                                    (kind: Overlay, id: "style1_big", size: (Fill, Px(3))),
                                                ],
                                            ),
                                            (
