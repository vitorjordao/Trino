// `ui check` fixture: a list of 200 rows is past the N64's and the 3DS's
// 128 nodes (Caps::max_ui_nodes) but fits the PC's 512.
(
    version: 1,
    name: "budget",
    preview: {"n": Int(200)},
    root: (children: [
        (kind: List(max: 200), bind: "n", children: [(kind: Rect(), size: (Px(1), Px(1)))]),
    ]),
)
