// Interior visibility demo (`trino_core::vis`): three rooms in a row,
// each a `Cell`, joined by `Portal` doorways. From inside a room only the
// rooms seen through the doorways are drawn. Baked as `[scenes.interior]`
// for the console self-tests (`castle64::selftest::portals`). Rooms B and C
// also name the asset groups their contents would stream from (scene v6,
// `trino_core::CellGroups`; `cargo xtask assets check` holds them to the
// manifest).
(
    version: 6,
    name: "interior",
    environment: (
        clear: (24, 22, 30),
        camera: (
            eye: (1.0, 1.6, 4.0),
            target: (23.0, 1.4, 4.0),
            fov: 60.0,
        ),
        light: (
            dir: (0.3, -0.8, 0.5),
            color: (255, 236, 210),
            ambient: 0.45,
            ambient_color: (170, 160, 210),
        ),
    ),
    entities: [
(
    name: "room-a",
    transform: (
        pos: (4.0, 2.0, 4.0),
        rot: (0.0, 0.0, 0.0),
        scale: (1.0, 1.0, 1.0),
