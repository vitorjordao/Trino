[package]
name = "{{name}}-web"
description = "Web host for {{name}} (`cargo trino build|run|test web`)."
version.workspace = true
edition.workspace = true
license.workspace = true
publish = false

# A cdylib for wasm-bindgen; off wasm32 it builds empty.
[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
{{name}} = { workspace = true }

[target.'cfg(target_arch = "wasm32")'.dependencies]
trino-platform-web = { workspace = true }
wasm-bindgen = { workspace = true }
